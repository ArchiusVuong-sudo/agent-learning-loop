# Copy to .env.local if you want to change anything. Every value is optional.

# Port for next start / next dev (the app binds 127.0.0.1).
PORT=4101

# Force replay mode: recorded responses from fixtures/, no login or key needed.
# Without it the app runs live when it finds a Claude Code login or ANTHROPIC_API_KEY.
DEMO_REPLAY=

# Only needed if you have no Claude Code login on this machine.
ANTHROPIC_API_KEY=

# Models per role. The judge runs on a different model than the agent it grades.
AGENT_MODEL=claude-haiku-5-5
JUDGE_MODEL=claude-opus-5-5
ANALYST_MODEL=claude-sonnet-5-5
AUTHOR_MODEL=claude-opus-5-5
LEARNER_MODEL=claude-opus-5-5

# At most this many SDK subprocesses at once.
MAX_CONCURRENT_RUNS=6

# Where the two SQLite files live (app.db and mastra.db).
DATA_DIR=./data

# Record every live response into fixtures/ (pnpm record sets this).
RECORD_FIXTURES=
